# ═══════════════════════════════════════════════════════════════
# CS2 Instant Alert — Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─── Application ───
APP_NAME=cs2-instant-alert
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG
APP_SECRET_KEY=change-me-to-a-random-64-char-string

# ─── Database (PostgreSQL) ───
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=cs2_alert
DATABASE_USER=cs2_alert
DATABASE_PASSWORD=change-me
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ─── Telegram Bot ───
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_ADMIN_IDS=[123456789,987654321]

# ─── Steam ───
STEAM_API_KEY=your-steam-web-api-key
STEAM_ANONYMOUS_LOGIN=true
# STEAM_USERNAME=
# STEAM_PASSWORD=

# ─── Pushover ───
PUSHOVER_APP_TOKEN=
PUSHOVER_DEFAULT_USER_KEY=

# ─── ntfy ───
NTFY_BASE_URL=https://ntfy.sh
NTFY_DEFAULT_TOPIC=cs2-updates

# ─── Discord ───
DISCORD_WEBHOOK_URL=

# ─── Email (SMTP) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true

# ─── FastAPI ───
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ─── Encryption ───
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── Monitoring ───
STEAM_CHECK_INTERVAL_SECONDS=5
STEAM_RACE_MODE_INTERVAL_SECONDS=2
STEAM_RACE_MODE_DURATION_MINUTES=30

# ─── AI Analysis (Gemini) ───
# Get free API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
